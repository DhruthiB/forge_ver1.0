[Unit]
Description="{{ forge_name }}-redis-cache"
PartOf={{ forge_name }}-redis.target

[Service]
User={{ user }}
Group={{ user }}
Restart=always
ExecStart={{ redis_server }} {{ redis_cache_config }}
StandardOutput=file:{{ forge_dir }}/logs/redis-cache.log
StandardError=file:{{ forge_dir }}/logs/redis-cache.error.log
WorkingDirectory={{ sites_dir }}
